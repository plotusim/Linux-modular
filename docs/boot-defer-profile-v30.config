# Linux 5.10.176 x86_64 QEMU/initramfs startup-defer profile.
# Apply on top of the v29 baseline, then run olddefconfig. This is a workload
# profile, not a universal kernel configuration.
CONFIG_DRM_I915=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_NFS_FS=m
CONFIG_EXT4_FS=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_R8169=m
CONFIG_SND_HDA_INTEL=m
